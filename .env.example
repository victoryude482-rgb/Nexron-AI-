# AI providers (OpenAI-compatible)
NEXRON_PROVIDER_PREFIXES=GROQ,GEMINI,OPENROUTER,LOCALAI,GITHUB_MODELS,XKIRO

GROQ_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_CAPABILITIES=chat,research,coding,tool_use
GROQ_FREE=true
GROQ_ENABLED=true

# xKiro: OpenAI-compatible gateway. API key stays server-side.
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=
XKIRO_MODEL=
XKIRO_CAPABILITIES=chat,research,coding,vision,tool_use
XKIRO_FREE=true
XKIRO_ENABLED=true

# Security
NEXRON_API_TOKEN=change-me
NEXRON_RATE_LIMIT=60

# Persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional LeadPilot integration
LEADPILOT_URL=
LEADPILOT_API_KEY=
