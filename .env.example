# AI providers (OpenAI-compatible or compatibility-shimmed).
# Defaults to GROQ,GEMINI,OPENROUTER,GITHUB_MODELS - all real, public,
# OpenAI-compatible endpoints. Add XKIRO/COGNEXA/LOCALAI only if you have a
# real self-hosted or custom endpoint for them; they have no safe default.
NEXRON_PROVIDER_PREFIXES=GROQ,GEMINI,OPENROUTER,GITHUB_MODELS

# Groq: https://api.groq.com/openai/v1 - free tier, OpenAI-compatible.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CAPABILITIES=chat,research,coding,tool_use
GROQ_FREE=true
GROQ_ENABLED=true

# Gemini: use Google's OpenAI-compatibility endpoint, NOT the raw Gemini API
# base - the raw API uses a different request/response schema and will fail
# every request through this OpenAI-compatible adapter.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CAPABILITIES=chat,research,coding,vision,tool_use
GEMINI_FREE=true
GEMINI_ENABLED=true

# OpenRouter: https://openrouter.ai/api/v1 - many free + paid models.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_CAPABILITIES=chat,research,coding,tool_use
OPENROUTER_FREE=true
OPENROUTER_ENABLED=true

# GitHub Models: https://models.inference.ai.azure.com - free with a GitHub
# personal access token as the API key.
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_MODEL=
GITHUB_MODELS_CAPABILITIES=chat,research,coding,tool_use
GITHUB_MODELS_FREE=true
GITHUB_MODELS_ENABLED=true

# Optional: xKiro/Cognexa/LocalAI custom adapters. Only set these if you
# actually run/own the corresponding endpoint - there is no public default.
# XKIRO_BASE_URL=
# XKIRO_API_KEY=
# XKIRO_MODEL=

# CORS: comma-separated list of allowed web-app origins for the API.
# Set this to your Vercel deployment URL(s) when moving off Render.
NEXRON_WEB_ORIGIN=https://nexron-web-prod.onrender.com,http://localhost:3000

# Security
NEXRON_API_TOKEN=change-me
NEXRON_RATE_LIMIT=60

# Persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional LeadPilot integration
LEADPILOT_URL=
LEADPILOT_API_KEY=
